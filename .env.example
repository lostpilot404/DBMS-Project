# Copy this file to .env and fill in your Oracle connection details locally.
# Do not commit .env or share the password in chat.
ORACLE_USER=hms_app
ORACLE_PASSWORD=replace_me_locally
# Either set ORACLE_DSN (Easy Connect or a full descriptor)...
ORACLE_DSN=localhost:1521/FREEPDB1
# ...or leave ORACLE_DSN blank and set ORACLE_HOST, ORACLE_PORT and ORACLE_SERVICE_NAME.
# ORACLE_HOST=localhost
# ORACLE_PORT=1521
# ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4
ORACLE_POOL_INCREMENT=1
FLASK_DEBUG=false
PORT=5000

# Day-only clinical dates; MUST match HMS_Settings.hospital_timezone (v6).
HOSPITAL_TIMEZONE=Asia/Kolkata
# Restricted runtime login may target a separate owner schema.
# ORACLE_SCHEMA=HMS_OWNER
# Personal accounts are required (migration007 and local manager bootstrap).
# False is accepted ONLY by explicit TESTING harnesses, never by the normal app.
HMS_AUTH_REQUIRED=true
# Set true for EVERY remote/HTTPS deployment. Keep false only for local HTTP.
HMS_COOKIE_SECURE=false
# Loopback-only default. Non-loopback also requires secure cookies and HTTPS.
HMS_HOST=127.0.0.1
# DEMO_USERNAME=choose_locally
# DEMO_PASSWORD=choose_a_unique_local_demo_secret
# Optional extra shared demo boundary; does NOT replace personal accounts. Use HTTPS
# behind a trusted proxy for any remote synthetic-data access. Never use real PHI.
