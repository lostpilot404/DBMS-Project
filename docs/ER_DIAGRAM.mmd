erDiagram
    DEPARTMENT {
        NUMBER department_id PK
        VARCHAR2 department_name UK
        VARCHAR2 location
    }
    DOCTOR {
        NUMBER doctor_id PK
        VARCHAR2 doctor_name
        VARCHAR2 specialization
        VARCHAR2 phone UK
        VARCHAR2 email UK
        NUMBER department_id FK
    }
    PATIENT {
        NUMBER patient_id PK
        VARCHAR2 patient_name
        DATE date_of_birth
        CHAR gender
        VARCHAR2 phone UK
        VARCHAR2 address
        VARCHAR2 blood_group
    }
    %% Lifecycle: Scheduled -> Checked In -> Waiting -> In Consultation -> Completed.
    %% Cancelled and No-show are terminal states; only active visits reserve time slots.
    APPOINTMENT {
        NUMBER appointment_id PK
        NUMBER patient_id FK
        NUMBER doctor_id FK
        DATE appointment_date
        VARCHAR2 appointment_time
        NUMBER duration_minutes
        VARCHAR2 status
    }
    ROOM {
        NUMBER room_id PK
        VARCHAR2 room_number UK
        VARCHAR2 room_type
        VARCHAR2 availability_status
    }
    ADMISSION {
        NUMBER admission_id PK
        NUMBER patient_id FK
        NUMBER room_id FK
        DATE admission_date
        DATE discharge_date
    }
    ADMISSION_ROOM_STAY {
        NUMBER stay_id PK
        NUMBER admission_id FK
        NUMBER room_id FK
        TIMESTAMP started_at
        TIMESTAMP ended_at
        CHAR is_active
        VARCHAR2 source
        TIMESTAMP recorded_at
    }
    MEDICINE {
        NUMBER medicine_id PK
        VARCHAR2 medicine_name
        VARCHAR2 manufacturer
        NUMBER price
        NUMBER stock_quantity
    }
    PRESCRIPTION {
        NUMBER prescription_id PK
        NUMBER patient_id FK
        NUMBER doctor_id FK
        NUMBER medicine_id FK
        VARCHAR2 dosage
        VARCHAR2 duration
        DATE prescription_date
    }
    BILL {
        NUMBER bill_id PK
        NUMBER patient_id FK
        DATE bill_date
        NUMBER consultation_charge
        NUMBER room_charge
        NUMBER medicine_charge
        NUMBER total_amount
        VARCHAR2 payment_status
        VARCHAR2 notes
    }

    BILL_ITEM {
        NUMBER item_id PK
        NUMBER bill_id FK
        VARCHAR2 description
        NUMBER quantity
        NUMBER unit_price
        NUMBER line_total
    }
    BILL_PAYMENT {
        NUMBER payment_id PK
        NUMBER bill_id FK
        NUMBER amount
        VARCHAR2 payment_method
        VARCHAR2 reference
        VARCHAR2 idempotency_key UK
        TIMESTAMP recorded_at
        VARCHAR2 recorded_timezone
    }
    BILL ||--o{ BILL_ITEM : contains
    BILL ||--o{ BILL_PAYMENT : receives

    DEPARTMENT ||--o{ DOCTOR : assigns
    PATIENT ||--o{ APPOINTMENT : books
    DOCTOR ||--o{ APPOINTMENT : attends
    PATIENT ||--o{ ADMISSION : has
    ROOM ||--o{ ADMISSION : current_or_last_room
    ADMISSION ||--o{ ADMISSION_ROOM_STAY : records
    ROOM ||--o{ ADMISSION_ROOM_STAY : assigned
    PATIENT ||--o{ PRESCRIPTION : receives
    DOCTOR ||--o{ PRESCRIPTION : writes
    MEDICINE ||--o{ PRESCRIPTION : names
    PATIENT ||--o{ BILL : billed

    %% Infrastructure, not clinical entities. Mutex intentionally serializes writes.
    HMS_SETTINGS {
        NUMBER singleton PK
        NUMBER schema_version
        VARCHAR2 hospital_timezone
    }
    HMS_WRITE_MUTEX {
        NUMBER mutex_id PK
    }
    %% V_INVOICE_BALANCES derives base + items, actual payments, balance and status.
    %% BILL.payment_status is legacy, not the derived ledger status or a receipt.
